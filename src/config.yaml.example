# === LLM SETTINGS ===
llm_provider: "mistral"          # Options: "openai", "mistral"
model_name: "mistral-medium-latest"
embedding_model: "mistral-embed"
temperature: 0.7

# Enable / disable query rewriting
use_query_rewriting: false
query_rewriting_prompt: "Rewrite the user query to improve document retrieval accuracy."

# === DATASET PATHS ===
dataset_private_path: "./dataset/private"
dataset_public_path: "./dataset/public"

# Types of supported input sources
web_urls: "web_urls"
yt_video_links: "yt_video_links"
text_files: "text_files"
pdf_files: "pdf_files"
rtdocs_files: "rtdocs_files"
html_files: "html_files"

# Vector DB persistence
persist_directory: "faiss_index"

# === APP CONFIGURATION ===
host: "127.0.0.1"
port: 8080

system_prompt: "You are an AI assistant. Use retrieved context to answer questions accurately. If the answer is not found, reply with: {{no_answer_message}}."

no_answer_message: "I don't have the answer to that question"
nr_documents: 5

# === HISTORY ===
default_chat_title: "New Chat"
history_messages_nr: 6

# === WEB SEARCH AGENT ===
web_search: "no_answer"  # "disabled" to turn off web search entirely
websearch_agent_code: "web_search_agent"
websearch_agent_model: "mistral-large-latest"
websearch_agent_name: "Websearch Agent"
websearch_agent_description: "Agent able to search the web for additional information."
websearch_agent_instructions: "You can perform a web search with `web_search` when needed."
websearch_agent_tools: '{"type": "web_search"}'
websearch_agent_completion_args: '{"temperature": 0.3, "top_p": 0.95}'

# === LOGO & BRANDING (optional) ===
logo_pth: ""
company_name: ""

# === FEEDBACK SETTINGS ===
feedback_options: "thumbs"  # thumbs, stars, faces

# === ANALYTICS ===
analytics_model: "mistral-small-latest"
analytics_prompt: "Generate a SQL query to answer the analytical question using the messages table."

# === DATABASE ===
dbpath: "users.db"

# === PAGES (Optional UI Routing) ===
landing_page: ""
contact_page: ""
client_page: ""
app_page: "http://localhost:8501"
contact_label: "Contact"